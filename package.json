{
  "name": "stick-motion",
  "version": "0.1.0",
  "description": "Code-generated 3D stick-figure motion, SVG playback, local video extraction and MP4 export",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayur2109/stick-motion.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./exercises": {
      "types": "./dist/exercises/index.d.ts",
      "import": "./dist/exercises/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./video/worker.js": "./dist/video/worker.js"
  },
  "bin": {
    "stick-motion": "./dist/export/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-worker.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "dev": "vite playground --host 127.0.0.1",
    "build:playground": "vite build playground",
    "assets": "node scripts/download-assets.mjs",
    "test:e2e": "npm run build:playground && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build:playground",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:package": "node scripts/test-package.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "sharp": ">=0.34"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mediapipe/tasks-vision": "1.1.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}

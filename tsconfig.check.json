{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "playground/**/*.tsx", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "playground/dist"]
}
